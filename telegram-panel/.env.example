PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Оставьте TG_* пустыми, чтобы запустить панель в демо-режиме с тестовыми чатами
# (без подключения к реальному Telegram — удобно для проверки интерфейса).
#
# Чтобы подключить реальный аккаунт:
# 1. Получите api_id и api_hash на https://my.telegram.org (раздел "API development tools").
# 2. Запустите `npm run login` и один раз пройдите вход (номер + код из Telegram + пароль 2FA,
#    если он включён). Скрипт выведет TG_SESSION — вставьте его сюда.
TG_API_ID=
TG_API_HASH=
TG_SESSION=
